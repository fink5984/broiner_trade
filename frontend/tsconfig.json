{
  "compilerOptions": {
    "target": "es2022", "module": "esnext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"], "jsx": "react-jsx", "skipLibCheck": true,
    "moduleResolution": "bundler", "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "moduleDetection": "force", "noEmit": true, "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
