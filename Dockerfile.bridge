# Same as fxcm_bridge/Dockerfile but built from the repo root (use RAILWAY_DOCKERFILE_PATH=Dockerfile.bridge).
FROM python:3.7-slim-bullseye
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY fxcm_bridge/requirements.txt .
RUN pip install -r requirements.txt && python -c "from forexconnect import ForexConnect, fxcorepy; print('forexconnect import OK')"
COPY fxcm_bridge/bridge.py .
CMD ["python", "-u", "bridge.py"]
