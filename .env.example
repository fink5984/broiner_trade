# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/broiner_trade
SECRET_KEY=change-me-long-random
SETTINGS_ENCRYPTION_KEY=generate-with-cryptography-Fernet.generate_key
GEMINI_API_KEY=
FRED_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Live trading is blocked by default and cannot be enabled via env alone.
TRADING_MODE=PAPER
